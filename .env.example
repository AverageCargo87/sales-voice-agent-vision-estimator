# Copy to .env and fill in. Nothing here is needed for `npm run setup:dry`,
# `npm run check:agent`, `npm run eval` or the estimator demo mode.

# ============================================================
# Voice agent (ElevenLabs Conversational AI)
# ============================================================
ELEVENLABS_API_KEY=
# A multilingual voice from the ElevenLabs voice library (must speak RU / EN / EL)
ELEVENLABS_VOICE_ID=

AGENT_NAME=Eric - Acme Steel Homes
LLM_MODEL=claude-haiku-4-5
# First = primary language, the rest become language_presets (comma-separated, no spaces)
AGENT_LANGUAGES=en,ru,el
# Optional TTS override. Empty = auto: en-primary -> eleven_multilingual_v2, otherwise eleven_turbo_v2_5
TTS_MODEL=
# Knowledge base file for RAG. Defaults to voice-agent/knowledge_base.md, falling back to the public example.
KB_PATH=

# n8n base URL without a trailing slash, e.g. https://your-instance.example.com
N8N_WEBHOOK_BASE=

# Human hand-off (used in the tool descriptions and the n8n alert workflow)
OWNER_NAME=the owner
OWNER_PHONE=
OWNER_TELEGRAM_CHAT_ID=

# SIP trunk (only for `npm run attach-phone`)
SIP_PHONE_NUMBER=
SIP_INBOUND_URI=
SIP_OUTBOUND_URI=
SIP_USERNAME=
SIP_PASSWORD=

# ============================================================
# Drawing-to-estimate engine
# ============================================================
# Without a key the server starts in demo mode: every guard still runs, the extraction
# is replayed from estimate/fixtures/demo-house.json and prices are computed by pricing.ts.
ANTHROPIC_API_KEY=
# Force demo mode even when a key is present: 1/0
DEMO_MODE=0

PORT=8099
# Listen on localhost by default; 0.0.0.0 to expose behind a proxy
HOST=127.0.0.1
# Comma-separated CORS origins for a website on another origin (empty = cross-origin closed)
CORS_ORIGIN=
# Trust X-Forwarded-For (only behind a reverse proxy): 1/0
TRUST_PROXY=0

# /api/analyze guards: every live analysis costs money
ANALYZE_RATE_LIMIT=6
ANALYZE_CONCURRENCY=2
ANALYZE_TIMEOUT_MS=360000

# `npm run eval -- extract` target (default http://localhost:8099)
ESTIMATE_URL=
