{
  "_comment": "Static baseline for the agent. Dynamic fields (name, prompt.prompt, prompt.llm, prompt.tool_ids, prompt.knowledge_base, tts.voice_id, tts.model_id, language, first_message, language_presets) are filled in by 03-create-agent.ts from .env, state.json and prompts/system_prompt.md.",
  "conversation_config": {
    "agent": {
      "first_message": "",
      "prompt": {
        "temperature": 0.4,
        "max_tokens": -1,
        "rag": {
          "enabled": true,
          "embedding_model": "e5_mistral_7b_instruct",
          "max_documents_length": 50000,
          "max_vector_distance": 0.6,
          "max_retrieved_rag_chunks_count": 20
        }
      }
    },
    "tts": {
      "model_id": "eleven_turbo_v2_5",
      "stability": 0.5,
      "similarity_boost": 0.75,
      "speed": 1.0,
      "use_speaker_boost": true,
      "agent_output_audio_format": "pcm_16000",
      "optimize_streaming_latency": 3
    },
    "asr": {
      "quality": "high",
      "provider": "elevenlabs",
      "user_input_audio_format": "pcm_16000",
      "keywords": [
        "Acme",
        "Acme Steel Homes",
        "ЛСТК",
        "LGSF",
        "пенобетон",
        "foam concrete",
        "αφρομπετόν",
        "Антипарохи",
        "Antiparochi",
        "αντιπαροχή",
        "Eric",
        "Shell Package",
        "Turnkey Package",
        "CGT",
        "Class A"
      ]
    },
    "turn": {
      "turn_timeout": 7,
      "silence_end_call_timeout": 30,
      "mode": "turn"
    },
    "conversation": {
      "text_only": false,
      "max_duration_seconds": 1800,
      "client_events": ["audio", "interruption", "user_transcript", "agent_response"]
    }
  },
  "platform_settings": {
    "evaluation": {
      "criteria": [
        {
          "id": "booked_consultation",
          "name": "Booked consultation",
          "type": "prompt",
          "conversation_goal_prompt": "Did the agent book a consultation with the partner architecture bureau using the book_consultation tool? Return 'success' if yes, 'failure' if no."
        },
        {
          "id": "qualified_segment",
          "name": "Qualified segment",
          "type": "prompt",
          "conversation_goal_prompt": "Did the agent identify and confirm the caller's segment (b2c_local / b2c_expat / landowner_antiparochi / developer / investor / business_horeca / complex_plot)? Return 'success' if yes, 'failure' if unclear."
        }
      ]
    },
    "data_collection": {
      "full_name": { "type": "string", "description": "Caller's name" },
      "phone": { "type": "string", "description": "Caller's phone in international format" },
      "email": { "type": "string", "description": "Caller's email" },
      "segment": { "type": "string", "description": "Segment: b2c_local, b2c_expat, landowner_antiparochi, developer, investor, business_horeca, complex_plot" },
      "language": { "type": "string", "description": "Conversation language: ru, en, el" },
      "location": { "type": "string", "description": "Where the plot or the caller is" },
      "budget_eur": { "type": "string", "description": "Caller's budget" }
    },
    "privacy": {
      "record_voice": true,
      "retention_days": 90,
      "delete_transcript_and_pii": false,
      "delete_audio": false
    },
    "call_limits": {
      "agent_concurrency_limit": -1,
      "daily_limit": 1000
    },
    "overrides": {
      "conversation_config_override": {
        "agent": {
          "prompt": { "prompt": true },
          "first_message": true,
          "language": true
        },
        "tts": { "voice_id": true }
      },
      "custom_llm_extra_body": false
    }
  },
  "tags": ["acme-steel-homes", "convai", "voice-agent"]
}
